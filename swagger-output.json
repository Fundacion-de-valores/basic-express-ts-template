                    "type": "object",
                    "properties": {
                      "product_id": {
                        "type": "number",
                        "example": 2
                      },
                      "quantity": {
                        "type": "number",
                        "example": 3
                      },
                      "unit_price": {
                        "type": "number",
                        "example": 45
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Venta creada; incluye items en la versión extendida"
