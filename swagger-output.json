      "post": {
        "tags": [
          "Sales"
        ],
        "summary": "Crear venta simple o venta con detalles en una transacción",
        "description": "Enviar customer_id y total, o customer_id e items. Con items, el total se calcula a partir de quantity y unit_price. No enviar total junto con items. Usar IDs existentes.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "customer_id": {
                  "type": "number",
                  "example": 1
                },
                "items": {
                  "type": "array",
